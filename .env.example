# NextHere Platform — Complete Environment Variables

# ─────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────
# Local (Docker):
DATABASE_URL="postgresql://nexthere:nexthere_password@localhost:5432/nexthere_db?schema=public"

# Production (Supabase — fill after Step 1 of DEPLOYMENT.md):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[SUPABASE_HOST]:5432/postgres"

# ─────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────
# Local:
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
API_URL="http://localhost:3001"
PORT=3001

# Production (fill after deploying API to Railway/Render):
# NEXT_PUBLIC_API_URL="https://nexthere-api.up.railway.app/api/v1"

# ─────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production:
# NEXT_PUBLIC_APP_URL="https://nexthere.in"

NEXT_PUBLIC_SITE_NAME="NextHere Services"
NODE_ENV="production"

# ─────────────────────────────────────────────────────────
# SUPABASE AUTH (get from supabase.com → Project Settings → API)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
