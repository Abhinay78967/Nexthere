# NextHere Platform — Complete Environment Variables

# ─────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────
# Local (Docker):
DATABASE_URL="postgresql://nexthere:nexthere_password@localhost:5432/nexthere_db?schema=public"

# Production (Supabase — fill after Step 1 of DEPLOYMENT.md):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[SUPABASE_HOST]:5432/postgres"

# ─────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────
# Local:
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
API_URL="http://localhost:3001"
PORT=3001

# Production (fill after deploying API to Railway/Render):
# NEXT_PUBLIC_API_URL="https://nexthere-api.up.railway.app/api/v1"

# ─────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production:
# NEXT_PUBLIC_APP_URL="https://nexthere.in"

NEXT_PUBLIC_SITE_NAME="NextHere Services"
NODE_ENV="production"

# ─────────────────────────────────────────────────────────
# SUPABASE AUTH (get from supabase.com → Project Settings → API)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─────────────────────────────────────────────────────────
# AI ENGINE (Google Gemini or OpenAI)
# ─────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ─────────────────────────────────────────────────────────
# SOCIAL MEDIA PRODUCTION APIS (Optional - Simulator active by default)
# ─────────────────────────────────────────────────────────
# LinkedIn Developer App (https://developer.linkedin.com)
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_ACCESS_TOKEN="your_linkedin_oauth_access_token"

# Meta for Developers - Instagram Graph API & Facebook Pages (https://developers.facebook.com)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_PAGE_ACCESS_TOKEN="your_meta_page_access_token"
META_WEBHOOK_VERIFY_TOKEN="nexthere_social_growth_2026"

# X / Twitter Developer Portal (https://developer.x.com)
TWITTER_API_KEY="your_twitter_api_key"
TWITTER_API_SECRET="your_twitter_api_secret"
TWITTER_BEARER_TOKEN="your_twitter_bearer_token"

