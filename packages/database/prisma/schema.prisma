generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// CORE ENUMS
// ---------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
}

// ---------------------------------------------------------
// CORPORATE CONFIGURATION
// ---------------------------------------------------------

model CompanyProfile {
  id               String   @id @default(uuid())
  legalName        String?
  displayName      String
  shortDescription String?
  longDescription  String?
  mission          String?
  vision           String?
  primaryEmail     String?
  primaryPhone     String?
  address          String?
  city             String?
  state            String?
  country          String?
  logo             Json?
  foundedYear      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SiteSettings {
  id            String   @id @default(uuid())
  siteName      String
  tagline       String?
  logo          Json?
  favicon       Json?
  socialLinks   Json?
  defaultSEO    Json?
  footerContent Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------
// BUSINESS ENTITIES
// ---------------------------------------------------------

model Industry {
  id               String          @id @default(uuid())
  title            String
  slug             String          @unique
  shortDescription String?
  description      String?
  media            Json?
  seo              Json?
  status           ContentStatus   @default(DRAFT)
  services         Service[]
  projects         Project[]
  caseStudies      CaseStudy[]
  faqs             FAQ[]
  articles         Article[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ServiceCategory {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  media       Json?
  services    Service[]
  leads       Lead[]
  createdAt   DateTime  @default(now())
}

model Service {
  id           String          @id @default(uuid())
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  title        String
  slug         String          @unique
  description  String
  capabilities Json?
  media        Json?
  active       Boolean         @default(true)
  leads        Lead[]
  inquiries    Inquiry[]
  industries   Industry[]
  projects     Project[]
  caseStudies  CaseStudy[]
  faqs         FAQ[]
  createdAt    DateTime        @default(now())
}

model Project {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  industryId     String?
  industry       Industry?     @relation(fields: [industryId], references: [id])
  services       Service[]
  
  status         ContentStatus @default(DRAFT)
  projectStatus  ProjectStatus @default(COMPLETED)
  location       String?
  completionDate DateTime?

  challenge      String?
  solution       String?
  execution      String?
  results        String?
  
  coverMedia     Json?
  gallery        Json?
  seo            Json?

  caseStudy      CaseStudy?
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model CaseStudy {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique
  projectId  String?  @unique
  project    Project? @relation(fields: [projectId], references: [id])
  industryId String?
  industry   Industry? @relation(fields: [industryId], references: [id])
  services   Service[]
  
  challenge  String?
  solution   String?
  outcome    String?
  media      Json?
  seo        Json?
  
  status     ContentStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ---------------------------------------------------------
// EDITORIAL & CONTENT
// ---------------------------------------------------------

model FAQ {
  id           String        @id @default(uuid())
  question     String
  answer       String
  category     String?
  serviceId    String?
  service      Service?      @relation(fields: [serviceId], references: [id])
  industryId   String?
  industry     Industry?     @relation(fields: [industryId], references: [id])
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Article {
  id         String        @id @default(uuid())
  title      String
  slug       String        @unique
  excerpt    String?
  content    String?
  coverMedia Json?
  author     String?
  tags       String[]
  status     ContentStatus @default(DRAFT)
  seo        Json?
  industryId String?
  industry   Industry?     @relation(fields: [industryId], references: [id])
  publishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ---------------------------------------------------------
// USERS & CRM (Existing)
// ---------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_MANAGER
  SALES
  OPERATIONS
  VIEWER
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
  INVITED
}

model ApplicationUser {
  id             String        @id @default(uuid())
  authProviderId String?       @unique
  email          String        @unique
  name           String?
  role           Role          @default(VIEWER)
  status         UserStatus    @default(ACTIVE)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model Organization {
  id           String            @id @default(uuid())
  name         String
  industry     String?
  contactEmail String?
  users        ApplicationUser[]
  projects     Project[]
  leads        Lead[]
  createdAt    DateTime          @default(now())
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  SERVICE_PAGE
  CONTACT_FORM
  QUOTE_REQUEST
  AI_ADVISOR
  REFERRAL
  OTHER
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id                String       @id @default(uuid())
  organizationId    String?
  name              String
  companyName       String?
  email             String
  phone             String?
  serviceCategoryId String?
  serviceId         String?
  source            LeadSource   @default(WEBSITE)
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  inquiries Inquiry[]

  organization    Organization?    @relation(fields: [organizationId], references: [id])
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id])
  service         Service?         @relation(fields: [serviceId], references: [id])

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model Inquiry {
  id          String   @id @default(uuid())
  leadId      String
  serviceId   String?
  subject     String
  message     String
  location    String?
  timeline    String?
  budgetRange String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([createdAt])
  @@index([leadId])
}
